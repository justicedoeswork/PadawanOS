# Copy to .env for local development. Never commit a real .env file
# (gateway/.env is gitignored) and never set any of these as build-time
# Vite variables -- they belong only to this server process.

PORT=4600
NODE_ENV=development

# Exactly one of these two. See src/password.ts for how to generate a
# JUSTICEOS_GATEWAY_PASSWORD_HASH value (preferred once actually deployed).
JUSTICEOS_GATEWAY_PASSWORD=replace-me
JUSTICEOS_GATEWAY_PASSWORD_HASH=

# Signs the justiceos_session cookie. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JUSTICEOS_SESSION_SECRET=replace-me-with-a-random-64-char-hex-string

# The Insurance Agent's PRIVATE ACP listener (Phase 1) -- never the
# public insurance-audit-agent.fly.dev host. For local dev against a
# locally-run Insurance Agent: ws://127.0.0.1:3001/acp
INSURANCE_AGENT_ACP_URL=ws://127.0.0.1:3001/acp

# The SAME value configured as ACP_GATEWAY_SERVICE_KEY on the Insurance
# Agent side -- a shared secret between exactly these two services.
# Never reuse the Insurance Agent's AUDIT_AGENT_API_KEY here.
ACP_GATEWAY_SERVICE_KEY=replace-me

ACP_ALLOWED_USER_ID=austin
ACP_ALLOWED_REALM_ID=9130357381765966

# Comma-separated exact origins allowed to open the /acp/insurance
# WebSocket. Include the Vite dev server's origin for local development.
JUSTICEOS_ALLOWED_ORIGINS=http://127.0.0.1:5173
