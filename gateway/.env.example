# Copy to .env for local development. Never commit a real .env file
# (gateway/.env is gitignored) and never set any of these as build-time
# Vite variables -- they belong only to this server process.

PORT=4600
NODE_ENV=development

# Exactly one of these two. See src/password.ts for how to generate a
# JUSTICEOS_GATEWAY_PASSWORD_HASH value (preferred once actually deployed).
JUSTICEOS_GATEWAY_PASSWORD=replace-me
JUSTICEOS_GATEWAY_PASSWORD_HASH=

# Signs the justiceos_session cookie. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JUSTICEOS_SESSION_SECRET=replace-me-with-a-random-64-char-hex-string

# The Insurance Agent's PRIVATE ACP listener (Phase 1) -- never the
# public insurance-audit-agent.fly.dev host. For local dev against a
# locally-run Insurance Agent: ws://127.0.0.1:3001/acp
INSURANCE_AGENT_ACP_URL=ws://127.0.0.1:3001/acp

# The SAME value configured as ACP_GATEWAY_SERVICE_KEY on the Insurance
# Agent side -- a shared secret between exactly these two services.
# Never reuse the Insurance Agent's AUDIT_AGENT_API_KEY here.
ACP_GATEWAY_SERVICE_KEY=replace-me

ACP_ALLOWED_USER_ID=austin
ACP_ALLOWED_REALM_ID=9130357381765966

# --- Marketing Agent integration (optional) ---
# The Marketing Agent's REST API root -- the gateway appends that
# service's own /api/marketing prefix itself. Use a private/internal
# destination in production (e.g. http://marketing-agent.internal:8787);
# for local dev against a locally-run Marketing Agent:
MARKETING_AGENT_BASE_URL=http://127.0.0.1:8787
# The Marketing Agent's own MARKETING_AGENT_API_KEY. Presented only on
# the server-to-server call; never sent to or needed by the browser.
MARKETING_AGENT_API_KEY=replace-me
# Optional: who the Marketing Agent records as the operator for actions
# taken through this gateway. Defaults to ACP_ALLOWED_USER_ID.
MARKETING_AGENT_ACTOR=

# Which side owns making the Marketing Agent tick. Exactly ONE owner --
# see docs/marketing-agent-padawan-integration.md. The default is the
# Marketing Agent's own AGENT_LOOP_ENABLED loop: this gateway runs no
# scheduler, and its Fly machine stops when idle, so it cannot be a
# reliable one (production refuses to start with "justiceos" here).
#   marketing-internal-loop (default) | justiceos | none
MARKETING_AGENT_SCHEDULER_OWNER=marketing-internal-loop

# The paid-research posture this deployment was configured with. Reporting
# only: the real switches are AGENT_EXECUTE_WEBSITE_RESEARCH and
# AGENT_EXECUTE_WATCHLIST_RECHECK on the Marketing Agent side. JusticeOS
# pins dryRun on every research call it makes, so it can never itself
# trigger provider spend whichever value is set here.
#   plan-only (default) | execute-allowed
MARKETING_AGENT_RESEARCH_EXECUTION=plan-only

# The Communications Agent's inbound marketing-event endpoint. Unset means
# no notification path is wired: the relay then READS the Marketing Agent's
# outbox without claiming anything, so events are retained by JusticeOS
# (Austin sees them in the app), stay PENDING upstream for whoever wires a
# receiver, and the health report says plainly that nobody is being
# notified. Private destination only, same rule as every other upstream.
COMMUNICATIONS_AGENT_EVENT_URL=
# The COMMUNICATIONS Agent's own credential -- a DIFFERENT secret for a
# different service. MARKETING_AGENT_API_KEY is never sent on this path.
COMMUNICATIONS_AGENT_API_KEY=

# The machine credential a scheduled driver presents to run ONE marketing
# event relay cycle (POST /api/marketing/agent/events/relay: claim ->
# deliver to Communications -> acknowledge). This gateway has no scheduler
# and its Fly machine stops when idle, so the relay is driven from outside
# by a platform cron, which has no browser and no session cookie.
#
# Deliberately narrow: NOT the gateway password (which would grant the
# whole app) and NOT the Marketing Agent key (which would grant approval
# rights upstream). The worst a leaked relay key can do is make one relay
# cycle run early. Unset means the relay is operator-triggered only -- an
# operator can still run a cycle from the app, and no cron can. Nothing
# falls open. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JUSTICEOS_RELAY_KEY=

# Comma-separated exact origins allowed to open the /acp/insurance
# WebSocket. Include the Vite dev server's origin for local development.
JUSTICEOS_ALLOWED_ORIGINS=http://127.0.0.1:5173
